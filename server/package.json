{
  "name": "worklog-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm --prefix ../web ci && npm --prefix ../web run build",
    "deploy": "npm run build && npm run db:migrate && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@cloudflare/puppeteer": "^1.4.0",
    "exceljs": "^4.4.0",
    "hono": "^4",
    "jose": "^6.2.12",
    "jszip": "^3.10.1",
    "zod": "^3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4"
  }
}
